{
  "name": "telegram-trading",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:bot": "tsx watch src/main.ts",
    "dev:web": "pnpm --dir web dev",
    "dev:all": "concurrently -n bot,web -c blue,green \"pnpm dev:bot\" \"pnpm dev:web\"",
    "build": "tsc -p tsconfig.json",
    "build:web": "pnpm --dir web build",
    "build:all": "pnpm build && pnpm build:web",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "fetch:symbols": "tsx scripts/fetch-krx-symbols.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.2",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "fflate": "^0.8.2",
    "grammy": "^1.32.0",
    "hono": "^4.12.18",
    "iconv-lite": "^0.7.2",
    "nanoid": "^5.0.9",
    "sharp": "^0.34.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "sharp"
    ]
  }
}
