# Caddy 설정 — sslip.io 도메인으로 자동 HTTPS (Let's Encrypt).
# DASHBOARD_DOMAIN 환경변수 = "1-2-3-4.sslip.io" 형태 (install.sh가 IP로 채움).
# DASHBOARD_PASSWORD_HASH = bcrypt 해시 (install.sh가 생성).
#
# ⚠️ 이 파일은 **기존 (basic_auth) 배포** 용. 신규 배포는 install.sh 가 인라인으로
# basic_auth 가 없는 Caddyfile 을 직접 disk 에 작성 + 봇 앱이 /login 으로 PIN 인증 처리.
# self-update.sh 가 .env 의 DASHBOARD_PIN_HASH 존재 시 이 파일 fetch 를 skip 하므로
# 신규 VPS 는 이 파일로 덮어쓰이지 않음.

{
  # 운영자 이메일 (Let's Encrypt 알림용, 빈 값이면 이메일 없이 ZeroSSL fallback)
  email {$CADDY_EMAIL}
}

{$DASHBOARD_DOMAIN} {
  # 비밀번호로 보호 (Caddy basic_auth).
  # username 은 docker-compose env (${DASHBOARD_USER:-admin}) 로 주입, 기본값 admin.
  basic_auth /* {
    {$DASHBOARD_USER} {$DASHBOARD_PASSWORD_HASH}
  }
  reverse_proxy bot:8080
}
