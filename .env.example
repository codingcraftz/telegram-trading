# ============================================================
# 필수 — 봇 작동에 반드시 필요
# ============================================================
TELEGRAM_BOT_TOKEN=
# 콤마 구분. 본인 텔레그램 chat_id (@userinfobot으로 확인)
ALLOWED_CHAT_IDS=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ============================================================
# 필수 — KIS 모의투자 (MODE=paper 일 때)
# ============================================================
# 한국투자증권 개발자센터 → 모의투자 신청 후 발급
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
# 모의 종합계좌 앞 8자리 (예: 50012345-01 → 50012345)
KIS_PAPER_STOCK=

# ============================================================
# 선택 — 실전(MODE=real)에서만 필요
# ============================================================
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCT_STOCK=

# ============================================================
# 선택 — 거의 안 씀 (빈 값으로 둬도 됨)
# ============================================================
# 선물옵션 — v1 미사용
KIS_ACCT_FUTURE=
KIS_PAPER_FUTURE=

# HTS ID — 실시간 체결통보 등 일부 알림 API에만 필요. v1은 빈 값.
KIS_HTS_ID=

# 계좌상품코드 — 보통 01 그대로
KIS_PROD_TYPE=01

# ============================================================
# 운영 설정
# ============================================================
# paper(모의) | real(실전)
MODE=paper

# 가드레일
MAX_TRADE_KRW=1000000
MAX_OPEN_POSITIONS=5
COOLDOWN_SEC=300
DAILY_LOSS_KRW=300000
INTENT_TTL_MIN=5

LOG_LEVEL=info
