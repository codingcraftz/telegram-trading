# ============================================================
# Telegram Trading 봇
# ============================================================
TELEGRAM_BOT_TOKEN=
# 콤마 구분 chat_id 화이트리스트. 본인 텔레그램 chat_id만.
ALLOWED_CHAT_IDS=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# paper(모의) | real(실전) — LLM/주문에 전달되는 env_dv 결정
MODE=paper

# 가드레일
MAX_TRADE_KRW=1000000
MAX_OPEN_POSITIONS=5
COOLDOWN_SEC=300
DAILY_LOSS_KRW=300000
INTENT_TTL_MIN=5

LOG_LEVEL=info

# ============================================================
# KIS Trading MCP (사이드카) — kis-mcp 컨테이너로 주입
# https://github.com/koreainvestment/open-trading-api 발급 키
# ============================================================

# 실전 키 (실전 거래용)
KIS_APP_KEY=
KIS_APP_SECRET=
# 종합계좌 앞 8자리 (예: 12345678)
KIS_ACCT_STOCK=
# 선물옵션 계좌 앞 8자리
KIS_ACCT_FUTURE=

# 모의(데모) 키 — MODE=paper일 때 사용됨
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
# 모의 종합계좌 앞 8자리
KIS_PAPER_STOCK=
KIS_PAPER_FUTURE=

# 공통
# 사용자 HTS ID
KIS_HTS_ID=
# 계좌상품코드 (보통 01)
KIS_PROD_TYPE=01
